{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Server.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Server.Api/bin/Debug/net10.0/Server.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Server.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5034",
        "Jwt__Secret": "CHANGE_ME_FOR_PRODUCTION_32+_CHARS_SECRET"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
