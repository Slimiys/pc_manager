<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Client.Avalonia.ViewModels"
             xmlns:uptimeControls="using:Client.Avalonia.Controls.Uptime"
             xmlns:historyControls="using:Client.Avalonia.Controls.History"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Avalonia.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Border Background="{StaticResource BrushBackground}" Padding="20">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Grid.Column="0"
                   Classes="header"
                   Text="{Localization CommonStrings.AppTitle}" />
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <TextBlock Classes="caption"
                     VerticalAlignment="Center"
                     Text="{Localization CommonStrings.LabelLanguage}" />
          <ComboBox MinWidth="200"
                    ItemsSource="{Binding LanguageRows}"
                    SelectedItem="{Binding SelectedLanguage}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LanguageRowViewModel">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </Grid>
      <uptimeControls:UptimeActionPanel Grid.Row="1" DataContext="{Binding ActionPanel}" />
      <uptimeControls:UptimeResultPanel Grid.Row="2" DataContext="{Binding ResultPanel}" />
      <historyControls:RequestHistoryPanel Grid.Row="3" DataContext="{Binding HistoryPanel}" />
    </Grid>
  </Border>
</UserControl>
