<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="DataGrid.redmine-issues-grid">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.redmine-issues-grid-frame">
    <Setter Property="Background" Value="{StaticResource BrushMutedDark}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="DataGrid.redmine-issues-grid DataGridColumnHeader">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="5,0,0,0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="36" />
  </Style>
  <Style Selector="DataGrid.redmine-issues-grid DataGridColumnHeader TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="DataGrid.redmine-issues-grid DataGridCell">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="DataGrid.redmine-issues-grid DataGridCell TextBlock.issue-cell-text">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="0.8" />
    <Setter Property="Foreground" Value="{StaticResource BrushForeground}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="8,0" />
  </Style>
  <Style Selector="DataGrid.redmine-issues-grid DataGridCell TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="0.8" />
    <Setter Property="Foreground" Value="{StaticResource BrushForeground}" />
  </Style>
  <Style Selector="DataGrid.redmine-issues-grid DataGridRow.new-issue DataGridCell TextBlock.issue-cell-text">
    <Setter Property="Foreground" Value="{StaticResource BrushNewIssue}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="DataGrid.redmine-issues-grid DataGridRow.new-issue:pointerover DataGridCell TextBlock.issue-cell-text">
    <Setter Property="Foreground" Value="{StaticResource BrushForeground}" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="Button.redmine-filter-header">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.redmine-filter-header:pointerover">
    <Setter Property="Background" Value="#20FFFFFF" />
  </Style>
  <Style Selector="Button.redmine-filter-header TextBlock.header-label">
    <Setter Property="Foreground" Value="{StaticResource BrushForeground}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.redmine-filter-header.filter-active TextBlock.header-label">
    <Setter Property="Foreground" Value="{StaticResource BrushNewIssue}" />
  </Style>
</Styles>
