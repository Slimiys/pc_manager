<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="ColorBrandPrimary">#D5A523</Color>
  <Color x:Key="ColorBrandSecondary">#AABC39</Color>
  <Color x:Key="ColorAccent">#FFBA01</Color>
  <Color x:Key="ColorMutedOlive">#806F40</Color>
  <Color x:Key="ColorMutedDark">#554D39</Color>
  <Color x:Key="ColorBackground">#33312B</Color>
  <Color x:Key="ColorForeground">#F2F2F2</Color>
</ResourceDictionary>
