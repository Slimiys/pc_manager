<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.Avalonia.ViewModels"
             x:Class="Client.Avalonia.Controls.Uptime.UptimeResultPanel"
             x:DataType="vm:UptimeResultPanelViewModel"
             mc:Ignorable="d"
             d:DesignWidth="400"
             d:DesignHeight="120">
  <Border Background="{StaticResource BrushMutedDark}"
          BorderBrush="{StaticResource BrushBorder}"
          BorderThickness="1"
          CornerRadius="8"
          Padding="12">
    <StackPanel Spacing="6">
      <TextBlock Classes="caption"
                 Text="{Localization CommandStrings.LabelCurrentUptimeResult}" />
      <TextBlock Classes="body"
                 TextWrapping="Wrap"
                 Text="{Binding ResultDisplay}" />
    </StackPanel>
  </Border>
</UserControl>
